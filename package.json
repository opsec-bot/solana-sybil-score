{
  "name": "solana-sybil-score",
  "version": "0.1.0",
  "description": "Open, explainable airdrop sybil scoring for Solana wallets. Every score shows the evidence behind it.",
  "type": "module",
  "license": "MIT",
  "main": "src/index.ts",
  "bin": {
    "sybil-score": "src/cli.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sybil-score": "tsx src/cli.ts"
  },
  "keywords": [
    "solana",
    "sybil",
    "airdrop",
    "anti-sybil",
    "clustering"
  ],
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
